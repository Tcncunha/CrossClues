# CrossClues - Environment Variables
# Copy this file to .env and fill in the values

# Supabase (novo: publishable + secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Compat: SUPABASE_KEY ainda suportado (fallback para publishable/secret)
SUPABASE_KEY=your-anon-or-service-key

# Server
PORT=3000
NODE_ENV=development

# Admin (optional, required in production)
# Used to protect /api/reload-words, /api/words POST, /api/supabase/* endpoints
ADMIN_SECRET=your-admin-secret-here
